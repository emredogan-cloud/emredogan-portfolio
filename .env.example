# Canonical origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://emredogan.work

# Analytics. '1' only in the deployed production environment; anywhere else the
# platform scripts 404 and pollute the console.
NEXT_PUBLIC_ENABLE_ANALYTICS=0

# Contact form delivery (optional).
# Without RESEND_API_KEY the contact form degrades to a mailto: link.
# Obtain from https://resend.com/api-keys — never commit the real value.
RESEND_API_KEY=
CONTACT_TO_EMAIL=emre30283@gmail.com
