{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,not-found,route,icon,opengraph-image,sitemap,robots}.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "*.config.{ts,mts,mjs,js}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
  "ignoreDependencies": ["tailwindcss", "geist"]
}
